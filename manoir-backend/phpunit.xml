<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="manoir_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="JWT_SECRET" value="base64:dGVzdC1zZWNyZXQtZm9yLWp3dC1zaWduYXR1cmVzLWluLXRoZS10ZXN0LXN1aXRlLW9ubHkhIQ=="/>
        <env name="JWT_ISSUER" value="http://localhost:8000"/>
        <env name="JWT_AUDIENCE" value="http://localhost:3000"/>
        <env name="FRONTEND_URL" value="http://localhost:3000"/>
        <env name="GOOGLE_CLIENT_ID" value="test-client-id.apps.googleusercontent.com"/>
        <env name="FEEXPAY_MODE" value="SANDBOX"/>
        <env name="FEEXPAY_API_KEY" value="test_key_phpunit"/>
        <env name="FEEXPAY_SHOP_ID" value="shop_phpunit"/>
        <env name="FEEXPAY_RETRIES" value="1"/>
        <env name="FORCE_HTTPS" value="false"/>
        <env name="LOG_SECURITY_CHANNELS" value="null"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
