APP_NAME="Le Manoir"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base locale : MySQL/MariaDB (demarrer MySQL dans XAMPP).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=manoir
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Origine du frontend Next.js (CORS strict + liens dans les mails).
# Production : FRONTEND_URL=https://lemanoir.bj
FRONTEND_URL=http://localhost:3000
# Origines supplementaires autorisees, separees par des virgules
# (ex : https://www.lemanoir.bj). Aucun joker.
CORS_EXTRA_ORIGINS=

# --- Mail (Phase 5) : SMTP Gmail, envoye en file d'attente ---
# En local, MAIL_MAILER=log ecrit les mails dans storage/logs/laravel.log.
# En production avec Gmail :
#   1. Activer la validation en 2 etapes sur le compte Google expediteur ;
#   2. Creer un « mot de passe d'application » (Compte Google > Securite >
#      Mots de passe des applications) : 16 caracteres, a mettre dans
#      MAIL_PASSWORD. Ce n'est PAS le mot de passe du compte.
#   3. MAIL_FROM_ADDRESS doit etre l'adresse Gmail elle-meme (ou un alias
#      verifie dans Gmail), sinon Gmail reecrit l'expediteur.
# Les mails partent en file d'attente : un worker doit tourner
# (php artisan queue:work), sinon ils restent dans la table `jobs`.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@lemanoir.bj"
MAIL_FROM_NAME="${APP_NAME}"

# Destinataire(s) des notifications de nouvelles demandes (reservation ou
# prolongation), separes par des virgules. Vide = tous les administrateurs.
ADMIN_NOTIFICATION_EMAIL=
# --- Google Agenda : lecture (site <- agenda) ---
# Un agenda par appartement. Adresse iCal secrete : Google Agenda >
# Parametres de l'agenda > Integrer l'agenda > "Adresse secrete au format iCal".
# Elle donne acces en lecture a tout l'agenda : ne jamais la publier.
GOOGLE_CALENDAR_ICAL_1=
GOOGLE_CALENDAR_ICAL_2=
GOOGLE_CALENDAR_ICAL_3=
GOOGLE_CALENDAR_ICAL_4=
GOOGLE_CALENDAR_ICAL_5=
GOOGLE_CALENDAR_ICAL_6=
GOOGLE_CALENDAR_ICAL_7=
GOOGLE_CALENDAR_ICAL_8=
GOOGLE_CALENDAR_ICAL_GENERAL=

# Delai au-dela duquel une consultation de disponibilite declenche une
# resynchronisation, apres l'envoi de la reponse.
CALENDAR_SYNC_STALE_MINUTES=15
# Jeton attendu par POST /api/calendar/sync. Vide = route desactivee.
CALENDAR_SYNC_TOKEN=

# --- Google Agenda : ecriture (site -> agenda) ---
# Calendar ID de chaque appartement (Parametres de l'agenda > "ID de l'agenda").
# Contrairement aux adresses iCal, ils ne suffisent pas a lire ou ecrire : il
# faut aussi partager l'agenda avec le compte de service.
GOOGLE_CALENDAR_ID_1=
GOOGLE_CALENDAR_ID_2=
GOOGLE_CALENDAR_ID_3=
GOOGLE_CALENDAR_ID_4=
GOOGLE_CALENDAR_ID_5=
GOOGLE_CALENDAR_ID_6=
GOOGLE_CALENDAR_ID_7=
GOOGLE_CALENDAR_ID_8=
GOOGLE_CALENDAR_ID_GENERAL=

# Cle privee du compte de service (JSON telecharge depuis Google Cloud).
# C'est un SECRET : le fichier est ignore par git. Sur Render, le deposer en
# "Secret File" et pointer le chemin ici.
GOOGLE_CALENDAR_CREDENTIALS=
# Mettre a false pour couper l'ecriture sans toucher au reste.
GOOGLE_CALENDAR_WRITE=true
# Prefixe du titre des evenements crees par le site.
GOOGLE_CALENDAR_WRITE_PREFIX=Site

# =====================================================================
# Securite / authentification (Phase 1)
# =====================================================================

# Production : APP_ENV=production et APP_DEBUG=false (jamais true en prod).
# HTTPS obligatoire (requete HTTP refusee en 426). Par defaut actif en
# production. TRUSTED_PROXIES : IP du proxy TLS de l'hebergeur ('*' si
# l'API n'est joignable QUE via ce proxy).
FORCE_HTTPS=
TRUSTED_PROXIES=*

# --- JWT ---
# Secret de signature HS256, distinct de APP_KEY, 32 octets minimum.
# Generer : php -r "echo 'base64:'.base64_encode(random_bytes(64)), PHP_EOL;"
JWT_SECRET=
# Emetteur (iss) et audience (aud) verifies a chaque requete.
# Par defaut : APP_URL et FRONTEND_URL.
JWT_ISSUER=
JWT_AUDIENCE=
# Jeton d'acces : 5 a 10 minutes. Refresh token : 7 a 30 jours.
JWT_ACCESS_TTL_MINUTES=10
JWT_REFRESH_TTL_DAYS=14
# Tolerance (s) pour deux onglets qui rafraichissent en meme temps.
JWT_REFRESH_REUSE_GRACE_SECONDS=10
# Fenetre de validite d'une reauthentification (actions sensibles).
JWT_REAUTH_TTL_MINUTES=10

# --- Cookies d'authentification (HttpOnly) ---
# Production (lemanoir.bj + api.lemanoir.bj, meme site) :
#   JWT_COOKIE_DOMAIN=.lemanoir.bj  JWT_COOKIE_SECURE=true  JWT_COOKIE_SAMESITE=lax
# Local (http://localhost) : domaine vide, SECURE=false.
JWT_COOKIE_DOMAIN=
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# Journal des evenements de securite (connexions, echecs, rejeux...).
# Disque ephemere (Render) : LOG_SECURITY_CHANNELS=stderr
LOG_SECURITY_CHANNELS=security_file
LOG_SECURITY_DAYS=90

# --- Connexion avec Google (Phase 1.2) ---
# Google Cloud Console > API et services > Identifiants > ID client OAuth
# (type « Application Web »). Ajouter https://lemanoir.bj (et
# http://localhost:3000 en dev) dans « Origines JavaScript autorisees ».
# Meme valeur que NEXT_PUBLIC_GOOGLE_CLIENT_ID cote frontend.
GOOGLE_CLIENT_ID=

# =====================================================================
# Paiement FeexPay (Phase 6) - https://docs.feexpay.me/?version=v2
# =====================================================================
# SANDBOX (tests, aucun argent ne circule) ou LIVE (production).
FEEXPAY_MODE=SANDBOX
# En SANDBOX, le SDK JavaScript FeexPay simule un paiement sans creer de
# transaction. Mettre true uniquement en local/testing pour que le serveur
# accepte cette confirmation et emette le Bon de Sejour. JAMAIS en production.
FEEXPAY_SANDBOX_TRUST_SDK=false
# Cle PRIVEE (Dashboard FeexPay > Cles API). Prefixe test_key_ en sandbox.
# Utilisee par le serveur pour les appels API. Le SDK JavaScript officiel
# exige aussi cette cle dans le navigateur pour le checkout du client connecte.
FEEXPAY_API_KEY=
# Identifiant PUBLIC de la boutique (champ `shop` de chaque requete).
FEEXPAY_SHOP_ID=
# Checkout officiel FeexPay (SDK JavaScript, choix du moyen de paiement
# fait par FeexPay). En SANDBOX, le frontend sert une copie locale corrigee
# du SDK (public/feexpay-sdk/sandbox.js) car le SDK officiel pointe vers
# l'API de production. En LIVE, le script officiel est charge tel quel.
# ATTENTION : le SDK exige FEEXPAY_API_KEY cote navigateur ; l'API ne la
# remet qu'au client connecte qui paie une reservation validee.
# FEEXPAY_SANDBOX_SDK_URL=/feexpay-sdk/sandbox.js
# FEEXPAY_SDK_URL=https://api-v2.feexpay.me/feexpay-javascript-sdk/index.js
FEEXPAY_CURRENCY=XOF
# Verification serveur : delai d'un appel FeexPay (s) et nouveaux essais
# apres une coupure reseau.
FEEXPAY_TIMEOUT=20
FEEXPAY_RETRIES=2
# URLs d'API (valeurs par defaut issues de la documentation FeexPay).
# FEEXPAY_SANDBOX_URL=https://sandbox-api.feexpay.me
# FEEXPAY_LIVE_URL=https://api-v2.feexpay.me
# Webhook : volontairement NON implemente en SANDBOX (a ajouter au passage
# en LIVE, via PaymentService::handleProviderNotification()).

# Idempotence des endpoints Laravel (wendelladriel/laravel-idempotency).
# Le cache doit supporter les verrous atomiques (database, redis...).
IDEMPOTENCY_TTL=3600