# En-tetes de securite du site statique (hebergement Apache / cPanel).
# Copie dans out/ par `next build` (export statique).

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS obligatoire.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Meme politique que lib/security.ts, plus frame-ancestors (ignore en <meta>).
  # Adapter l'origine de l'API si elle change.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/client https://*.feexpay.me; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style https://*.feexpay.me; img-src 'self' data: blob: https://images.unsplash.com https://*.googleusercontent.com https://*.feexpay.me https://api.lemanoir.bj; media-src 'self' blob: https://api.lemanoir.bj; font-src 'self' data:; connect-src 'self' https://api.lemanoir.bj https://accounts.google.com/gsi/ https://*.feexpay.me; frame-src https://accounts.google.com/gsi/ https://*.feexpay.me; object-src 'none'; base-uri 'self'; form-action 'self' https://*.feexpay.me; frame-ancestors 'none'"
</IfModule>
